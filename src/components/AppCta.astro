---
import Icon from './Icon.astro';
import { installUrl } from '../data/site';

interface Props {
  title: string;
  text: string;
  placement: string;
}
const { title, text, placement } = Astro.props;
---

<aside class="app-cta">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="btn btn-light" href={installUrl(placement)} target="_blank" rel="noopener">
    Install free on Shopify <Icon name="arrow" />
  </a>
</aside>

<style>
  .app-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(28px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #5b4fe6, #4135c4);
    color: #e4e1ff;
  }
  .app-cta div {
    max-width: 560px;
  }
  .app-cta h2 {
    color: #fff;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    margin-bottom: 8px;
  }
</style>

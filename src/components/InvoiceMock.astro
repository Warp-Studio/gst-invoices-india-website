---
import Icon from './Icon.astro';
---

<div class="invoice-wrap" aria-label="Example GST invoice generated by the app" role="img">
  <div class="invoice" aria-hidden="true">
    <div class="inv-top">
      <span>GSTIN&nbsp; 09ABCDE1234F1ZY</span>
      <span class="inv-original">ORIGINAL</span>
    </div>

    <div class="inv-brand">
      <span class="inv-mark">✿</span>
      <div>
        <p class="inv-kicker">TAX INVOICE</p>
        <p class="inv-name">Lotus Footwear Co.</p>
      </div>
    </div>

    <dl class="inv-meta">
      <div><dt>Invoice no</dt><dd>INV-1526/26</dd></div>
      <div><dt>Date</dt><dd>26 Apr 2026</dd></div>
      <div class="wide"><dt>Place of supply</dt><dd>Uttar Pradesh (09)</dd></div>
    </dl>

    <div class="inv-table">
      <div class="inv-row inv-head">
        <span>Item</span><span>Taxable</span><span class="gst-col">GST<em class="rule-tag">5% · under ₹2,500</em></span><span>CGST</span><span>SGST</span>
      </div>
      <div class="inv-row">
        <span class="item">
          Leather Juttis
          <small>HSN 6403 · Qty 1</small>
        </span>
        <span>₹2,410.71</span>
        <span class="gst-col"><b>5%</b></span>
        <span>₹60.27</span>
        <span>₹60.27</span>
      </div>
    </div>

    <div class="inv-totals">
      <div><span>Total before tax</span><span>₹2,410.71</span></div>
      <div><span>Total GST (5%)</span><span>₹120.54</span></div>
      <div class="grand"><span>Grand total</span><span>₹2,531.25</span></div>
    </div>

    <p class="inv-foot">This invoice is computer-generated, no signature required</p>
  </div>

  <div class="float-chip chip-wa">
    <span class="chip-icon wa"><Icon name="send" size={16} /></span>
    <span><b>INV-1526.pdf</b> sent on WhatsApp</span>
  </div>
  <div class="float-chip chip-tax">
    <span class="chip-icon"><Icon name="checkCircle" size={16} /></span>
    <span>CGST + SGST applied</span>
  </div>
</div>

<style>
  .invoice-wrap {
    position: relative;
    padding: 12px 0 28px;
  }

  .invoice {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    background: #fff;
    border-radius: 20px;
    padding: 28px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }

  .inv-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 11.5px;
    color: var(--muted);
  }

  .inv-original {
    letter-spacing: 0.2em;
    color: #aaa7bd;
  }

  .inv-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .inv-mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #fde7ef;
    color: #e0457b;
    font-size: 22px;
    flex: none;
  }

  .inv-kicker {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .inv-name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .inv-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    margin: 16px 0 0;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .inv-meta div {
    display: flex;
    gap: 10px;
  }

  .inv-meta .wide {
    grid-column: 1 / -1;
  }

  .inv-meta dt {
    color: #9d9ab0;
  }

  .inv-meta dd {
    margin: 0;
    font-weight: 500;
  }

  .inv-table {
    margin-top: 48px;
  }

  .inv-row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 0.8fr 0.8fr 0.8fr;
    gap: 8px;
    align-items: center;
    text-align: right;
  }

  .inv-row > :first-child {
    text-align: left;
  }

  .inv-head {
    font-size: 11.5px;
    color: #9d9ab0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .inv-row:not(.inv-head) {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .item {
    font-weight: 500;
    display: grid;
    gap: 2px;
  }

  .item small {
    font-size: 10.5px;
    color: #9d9ab0;
    font-weight: 400;
  }

  .gst-col {
    text-align: center;
    position: relative;
  }

  .inv-row:not(.inv-head) .gst-col b {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--success-soft);
    color: var(--success);
  }

  .rule-tag {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%);
    white-space: nowrap;
    font-style: normal;
    font-size: 10.5px;
    font-weight: 700;
    color: #fff;
    background: #0f6b45;
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 6px 14px -6px rgb(15 107 69 / 0.6);
  }

  .rule-tag::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #0f6b45;
  }

  .inv-totals {
    display: grid;
    gap: 8px;
    margin-left: auto;
    margin-top: 18px;
    max-width: 290px;
  }

  .inv-totals div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }

  .inv-totals .grand {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
  }

  .inv-foot {
    margin-top: 26px;
    text-align: center;
    font-size: 10.5px;
    color: #aaa7bd;
  }

  .float-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    font-size: 13.5px;
    color: var(--text);
    white-space: nowrap;
  }

  .float-chip b {
    color: var(--ink);
  }

  .chip-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--violet-soft);
    color: var(--violet);
  }

  .chip-icon.wa {
    background: #25d366;
    color: #fff;
  }

  .chip-wa {
    right: -24px;
    bottom: 0;
  }

  .chip-tax {
    left: -36px;
    top: 66%;
  }

  @media (max-width: 1080px) {
    .chip-wa {
      right: 12px;
    }
    .chip-tax {
      left: 12px;
    }
  }

  @media (max-width: 520px) {
    .invoice {
      font-size: 11px;
      padding: 20px 16px;
    }
    .inv-row {
      grid-template-columns: 1.5fr 1.1fr 0.8fr 0.9fr 0.9fr;
      gap: 4px;
    }
    .inv-name {
      font-size: 17px;
    }
    .chip-tax {
      display: none;
    }
    .float-chip {
      font-size: 12.5px;
    }
  }
</style>

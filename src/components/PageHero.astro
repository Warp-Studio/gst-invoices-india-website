---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(900px 400px at 90% 0%, rgb(91 79 230 / 0.12), transparent 60%),
      var(--lavender);
    padding-block: clamp(48px, 7vw, 88px) clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--line);
  }
  h1 {
    font-size: clamp(2.25rem, 4.6vw, 3.5rem);
    max-width: 820px;
  }
  .lede {
    max-width: 640px;
  }
</style>

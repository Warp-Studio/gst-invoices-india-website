---
interface Props {
  count?: number;
  size?: string;
}
const { count = 5, size = '1em' } = Astro.props;
---

<span class="stars" style={`font-size:${size}`} role="img" aria-label={`${count} out of 5 stars`}>
  {
    Array.from({ length: count }).map(() => (
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z" />
      </svg>
    ))
  }
</span>

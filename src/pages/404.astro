---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found | GST Invoices India">
  <section class="section not-found">
    <div class="container">
      <p class="code mono">404</p>
      <h1>This page isn’t on the invoice.</h1>
      <p class="lede">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the homepage <Icon name="arrow" /></a>
        <a class="btn btn-secondary" href="/gst-calculator/">Open the GST calculator</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    text-align: center;
    background: var(--lavender);
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .code {
    font-size: 1rem;
    font-weight: 700;
    color: var(--violet);
    letter-spacing: 0.2em;
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>

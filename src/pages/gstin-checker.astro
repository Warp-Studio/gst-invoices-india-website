---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AppCta from '../components/AppCta.astro';
import Icon from '../components/Icon.astro';
import { stateCodes, panHolderTypes } from '../lib/gst';

const example = '09ABCDE1234F1ZY';
const parts = [
  { chars: '09', name: 'State code', text: 'Where the business is registered. 09 is Uttar Pradesh.' },
  { chars: 'ABCDE1234F', name: 'PAN', text: 'The PAN of the business owner or entity.' },
  { chars: '1', name: 'Entity number', text: 'Registration count under the same PAN in that state: 1–9, then A–Z.' },
  { chars: 'Z', name: 'Default', text: '“Z” for regular taxpayers.' },
  { chars: 'Y', name: 'Check digit', text: 'Calculated from the first 14 characters to catch typos.' },
];
---

<Base
  title="GSTIN Checker: Validate a GST Number & Find Its State and PAN | GST Invoices India"
  description="Free GSTIN checker. Validate the format and check digit of any GST number, and see the state, PAN and business type it belongs to. Runs entirely in your browser."
>
  <PageHero
    eyebrow="Free tool"
    title="GSTIN Checker"
    lede="Check that a GST number is typed correctly, and see the state, PAN and business type it belongs to. Runs in your browser; nothing is sent anywhere."
  />

  <section class="section tool-section">
    <div class="container">
      <div class="checker card">
        <form id="gstin-form" class="checker-form" novalidate>
          <label for="gstin" class="label">GSTIN</label>
          <div class="checker-row">
            <input
              class="input mono gstin-input"
              id="gstin"
              name="gstin"
              type="text"
              maxlength="20"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              placeholder="e.g. 09ABCDE1234F1ZY"
            />
            <button class="btn btn-primary" type="submit"><Icon name="search" size={18} /> Check</button>
          </div>
          <p class="hint">
            No GSTIN handy? <button type="button" class="link-btn" data-example={example}>Try an example</button>
          </p>
        </form>

        <div class="checker-result" aria-live="polite">
          <p class="placeholder" data-state="idle">Enter a 15-character GSTIN to check it.</p>

          <div data-state="result" hidden>
            <div class="verdict">
              <span class="verdict-icon"></span>
              <div>
                <strong class="verdict-title"></strong>
                <p class="verdict-text"></p>
              </div>
            </div>
            <ul class="issues"></ul>
            <dl class="details"></dl>
            <p class="portal-note">
              A correct check digit means the number is well-formed, not that the registration is active. To confirm
              the business name and status, search it on the <a
                href="https://services.gst.gov.in/services/searchtp"
                target="_blank"
                rel="noopener">official GST portal</a
              >.
            </p>
          </div>
        </div>
      </div>

      <div class="anatomy">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2>What the 15 characters of a GSTIN mean</h2>
        </div>
        <ol class="anatomy-parts">
          {
            parts.map((p) => (
              <li class="card">
                <span class="chars mono">{p.chars}</span>
                <strong>{p.name}</strong>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>

        <div class="tables">
          <details class="card table-card">
            <summary>GST state codes <Icon name="plus" size={18} /></summary>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Code</th><th>State / UT</th></tr></thead>
                <tbody>
                  {
                    Object.entries(stateCodes).map(([code, name]) => (
                      <tr>
                        <td class="mono">{code}</td>
                        <td>{name}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </details>
          <details class="card table-card">
            <summary>PAN holder types (4th character of the PAN) <Icon name="plus" size={18} /></summary>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Letter</th><th>Holder type</th></tr></thead>
                <tbody>
                  {
                    Object.entries(panHolderTypes).map(([letter, name]) => (
                      <tr>
                        <td class="mono">{letter}</td>
                        <td>{name}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div>

      <AppCta
        title="Put your customers’ GSTINs on every B2B invoice"
        text="GST Invoices India adds the buyer’s GSTIN to invoices automatically and applies the right CGST, SGST or IGST for their state."
        placement="gstin-checker"
      />
    </div>
  </section>
</Base>

<script>
  import { checkGstin, normalizeGstin } from '../lib/gst';

  const form = document.getElementById('gstin-form') as HTMLFormElement;
  const input = form.querySelector<HTMLInputElement>('#gstin')!;
  const root = document.querySelector<HTMLElement>('.checker-result')!;
  const idle = root.querySelector<HTMLElement>('[data-state="idle"]')!;
  const panel = root.querySelector<HTMLElement>('[data-state="result"]')!;
  const title = panel.querySelector<HTMLElement>('.verdict-title')!;
  const text = panel.querySelector<HTMLElement>('.verdict-text')!;
  const issues = panel.querySelector<HTMLUListElement>('.issues')!;
  const details = panel.querySelector<HTMLDListElement>('.details')!;

  function row(label: string, value: string) {
    const div = document.createElement('div');
    const dt = document.createElement('dt');
    const dd = document.createElement('dd');
    dt.textContent = label;
    dd.textContent = value;
    div.append(dt, dd);
    return div;
  }

  function render(show: boolean) {
    const value = normalizeGstin(input.value);
    if (!value || !show) {
      idle.hidden = false;
      panel.hidden = true;
      return;
    }

    const r = checkGstin(value);
    idle.hidden = true;
    panel.hidden = false;
    panel.dataset.valid = String(r.valid);
    panel.dataset.warn = String(r.valid && r.warnings.length > 0);

    title.textContent = r.valid ? 'This GSTIN looks valid' : 'This GSTIN is not valid';
    text.textContent = r.valid
      ? `${r.gstin} has the right format and a correct check digit.`
      : `${r.gstin} has ${r.errors.length === 1 ? 'a problem' : 'some problems'}:`;

    issues.replaceChildren(
      ...[...r.errors.map((m) => ['error', m]), ...r.warnings.map((m) => ['warning', m])].map(([kind, m]) => {
        const li = document.createElement('li');
        li.className = kind;
        li.textContent = m;
        return li;
      }),
    );

    details.replaceChildren();
    if (r.gstin.length === 15) {
      if (r.state) details.append(row('State', `${r.state} (${r.gstin.slice(0, 2)})`));
      if (r.pan) details.append(row('PAN', r.pan));
      if (r.holderType) details.append(row('Business type', r.holderType));
      if (r.entityNumber && r.entityNumber !== '0') details.append(row('Registration no. under this PAN', r.entityNumber));
    }
    details.hidden = details.childElementCount === 0;
  }

  input.addEventListener('input', () => {
    const value = normalizeGstin(input.value);
    // Check live once the full 15 characters are in; before that, wait for submit.
    render(value.length >= 15 || !panel.hidden);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    render(true);
  });
  document.querySelector<HTMLButtonElement>('[data-example]')?.addEventListener('click', (e) => {
    input.value = (e.currentTarget as HTMLButtonElement).dataset.example!;
    render(true);
    input.focus();
  });

  const fromUrl = new URLSearchParams(location.search).get('gstin');
  if (fromUrl) {
    input.value = fromUrl;
    render(true);
  }
</script>

<style>
  .tool-section {
    padding-top: clamp(40px, 5vw, 64px);
  }

  .checker {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .checker-form {
    padding: clamp(24px, 4vw, 40px);
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
  }

  .checker-row {
    display: flex;
    gap: 10px;
  }

  .gstin-input {
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-width: 0;
  }

  .gstin-input::placeholder {
    letter-spacing: 0.02em;
    text-transform: none;
    color: #a8a5bb;
  }

  .hint {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .link-btn {
    font: inherit;
    color: var(--violet);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .checker-result {
    background: var(--lavender);
    border-left: 1px solid var(--line);
    padding: clamp(24px, 4vw, 40px);
  }

  .placeholder {
    color: var(--muted);
    height: 100%;
    display: grid;
    place-items: center;
    text-align: center;
    min-height: 120px;
  }

  .verdict {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .verdict-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--danger-soft);
  }

  .verdict-icon::before {
    font-weight: 800;
    font-size: 1.125rem;
    content: '✕';
    color: var(--danger);
  }

  [data-valid='true'] .verdict-icon {
    background: var(--success-soft);
  }

  [data-valid='true'] .verdict-icon::before {
    content: '✓';
    color: var(--success);
  }

  .verdict-title {
    font-size: 1.1875rem;
    color: var(--danger);
    display: block;
  }

  [data-valid='true'] .verdict-title {
    color: var(--success);
  }

  .verdict-text {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .issues {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    gap: 8px;
  }

  .issues:empty {
    display: none;
  }

  .issues :global(li) {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.9375rem;
  }

  .issues :global(.error) {
    background: var(--danger-soft);
    color: #8f1c15;
  }

  .issues :global(.warning) {
    background: #fff4e0;
    color: #7a4b00;
  }

  .details {
    margin: 20px 0 0;
    display: grid;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .details :global(div) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .details :global(div:last-child) {
    border-bottom: 0;
  }

  .details :global(dt) {
    color: var(--muted);
  }

  .details :global(dd) {
    margin: 0;
    font-weight: 700;
    color: var(--ink);
    text-align: right;
  }

  .portal-note {
    margin-top: 16px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .checker {
      grid-template-columns: 1fr;
    }
    .checker-result {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 480px) {
    .checker-row {
      flex-direction: column;
    }
    .gstin-input {
      font-size: 1.0625rem;
    }
  }

  .anatomy {
    margin-block: clamp(56px, 8vw, 96px);
  }

  .anatomy .section-head {
    margin-bottom: 32px;
  }

  .anatomy-parts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 0.8fr 1.8fr 0.9fr 0.9fr 0.9fr;
    gap: 12px;
  }

  .anatomy-parts li {
    padding: 20px;
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .chars {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--violet);
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }

  .anatomy-parts strong {
    color: var(--ink);
  }

  .anatomy-parts p {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .anatomy-parts {
      grid-template-columns: 1fr 1fr;
    }
    .anatomy-parts li:nth-child(2) {
      grid-row: span 1;
    }
  }

  @media (max-width: 480px) {
    .anatomy-parts {
      grid-template-columns: 1fr;
    }
  }

  .tables {
    margin-top: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  .table-card summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 18px 22px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
  }

  .table-card summary::-webkit-details-marker {
    display: none;
  }

  .table-card summary :global(svg) {
    color: var(--violet);
    flex: none;
    transition: transform 0.2s ease;
  }

  .table-card[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .table-scroll {
    overflow-x: auto;
    padding: 0 22px 18px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th {
    text-align: left;
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 700;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  td {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  td:first-child,
  th:first-child {
    width: 72px;
  }

  @media (max-width: 760px) {
    .tables {
      grid-template-columns: 1fr;
    }
  }
</style>
